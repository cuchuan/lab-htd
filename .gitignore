# ---------------------------------------------------------------------------
# Project outputs
# ---------------------------------------------------------------------------
# Newly generated model checkpoints during training are saved under models/.
# Ignore new checkpoints, but explicitly keep the 4 pre-trained sample weights
# that are already released with the repo.
models/**/ckpt_*.pt
!models/Sandiego/ckpt_159_.pt
!models/Sandiego2/ckpt_12_.pt
!models/abu-airport-2/ckpt_187_.pt
!models/abu-beach-4/ckpt_180_.pt

# Large hyperspectral datasets (.mat). The sample datasets already tracked in
# git are not affected. Uncomment the next line if you do NOT want to track
# any new .mat data files.
# *.mat

# Detection result maps / figures produced at eval time
*.png
!assets/*.png
